@page "/admincase"
@page "/demos-to-discord"
@attribute [ExcludeFromInteractiveRouting]
@rendermode RenderMode.InteractiveServer
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject DemosToDiscordWebfront Webfront
@inject DemosToDiscordConfig Config
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Cheating Case Review</PageTitle>

@if (_loading)
{
    <div class="dtd-native-state"><i class="ph ph-spinner animate-spin"></i><span>Loading Cheating Case Review…</span></div>
}
else if (_legacyRoute)
{
    <div class="dtd-native-state"><i class="ph ph-arrow-right animate-pulse"></i><span>Moving to the new Cheating Case Review address…</span></div>
}
else if (!_authorised)
{
    <div class="dtd-native-state dtd-native-error"><i class="ph ph-lock-key"></i><span>You do not have permission to open Cheating Case Review.</span></div>
}
else if (!_available)
{
    <div class="dtd-native-state"><i class="ph ph-eye-slash"></i><span>Cheating Case Review is disabled in DemosToDiscord configuration.</span></div>
}
else if (!string.IsNullOrWhiteSpace(_error))
{
    <div class="dtd-native-state dtd-native-error"><i class="ph ph-warning-circle"></i><span>@_error</span></div>
}
else
{
    <div data-enhance-nav="false">
        @((MarkupString)_markup)
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _loading = true;
    private bool _authorised;
    private bool _available;
    private string _markup = string.Empty;
    private string? _error;
    private bool _legacyRoute;
    private IJSObjectReference? _navigationBridge;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _authorised = false;
        _available = false;
        _markup = string.Empty;
        _error = null;
        _legacyRoute = new Uri(Navigation.Uri).AbsolutePath.Equals(
            DemosToDiscordWebfront.LegacyNativePath,
            StringComparison.OrdinalIgnoreCase);

        if (_legacyRoute)
        {
            _loading = false;
            return;
        }

        var state = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
        _authorised = NativeWebSupport.HasPermission(state?.User, Config.WebfrontMinimumPermission);
        _available = Config.EnableWebfrontDashboard;

        if (_authorised && _available)
        {
            try
            {
                _markup = await Webfront.RenderNativeAsync(
                    NativeWebSupport.ClientId(state?.User),
                    NativeWebSupport.Query(Navigation.Uri),
                    CancellationToken.None);
            }
            catch (Exception exception)
            {
                _error = $"Cheating Case Review could not be loaded: {exception.Message}";
            }
        }

        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (_legacyRoute)
        {
            var current = new Uri(Navigation.Uri);
            Navigation.NavigateTo(
                $"{DemosToDiscordWebfront.NativePath}{current.Query}",
                forceLoad: true,
                replace: true);
            return;
        }

        try
        {
            _navigationBridge = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "/_content/DemosToDiscord/navigation-bridge.js?v=2.6.3");
            await _navigationBridge.InvokeVoidAsync("install");
        }
        catch (JSDisconnectedException)
        {
            // The page is already leaving, so no cleanup is required.
        }
        catch (JSException)
        {
            // Navigation remains usable through a normal browser refresh if static assets are unavailable.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_navigationBridge is null)
        {
            return;
        }

        try
        {
            await _navigationBridge.InvokeVoidAsync("uninstall");
            await _navigationBridge.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Expected when a full document navigation has already disconnected the circuit.
        }
        catch (JSException)
        {
            // Ignore cleanup failures while the host is tearing down the interactive page.
        }
    }
}
